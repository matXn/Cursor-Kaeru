{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "安装程序窗口的最小权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "allow-plan",
    "allow-choose-dir",
    "allow-install",
    "allow-launch"
  ]
}
